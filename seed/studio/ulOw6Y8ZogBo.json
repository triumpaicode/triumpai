{"id": "ulOw6Y8ZogBo", "owner": "showcase", "title": "RoboScan — Robinhood Chain Explorer", "createdAt": 1790349411509, "updatedAt": 1790349560031, "versions": [{"prompt": "Blockchain explorer for Robinhood Chain — network stats bar, latest blocks and latest transactions tables, gas tracker, search with glowing focus. Visual theme (follow strictly): near-black background (#050b09), neon green #39ff14 and electric blue #5bd1ff as the ONLY accent colors, subtle pixel-grid / scanline texture, glowing edges and soft neon bloom, bold grotesk headings with monospace details, futuristic cyber-crypto aesthetic. Desktop 1440px wide, fill the first screen with the hero.", "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>RoboScan — Robinhood Chain Explorer</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#07050b;\n  --bg-2:#0b0711;\n  --panel:rgba(13,9,20,.72);\n  --line:rgba(246,91,255,.16);\n  --line-2:rgba(20,135,255,.18);\n  --green:#1487ff;\n  --blue:#f65bff;\n  --txt:#e3dff3;\n  --dim:#877e9a;\n  --max:1440px;\n}\n*{box-sizing:border-box}\nhtml,body{margin:0;padding:0}\nhtml{scroll-behavior:smooth}\nbody{\n  background:var(--bg);\n  color:var(--txt);\n  font-family:'Space Grotesk',system-ui,sans-serif;\n  -webkit-font-smoothing:antialiased;\n  overflow-x:hidden;\n  line-height:1.5;\n}\n/* ---------- texture layers ---------- */\n.fx{position:fixed;inset:0;pointer-events:none;z-index:0}\n.fx-grid{\n  background-image:\n    linear-gradient(rgba(246,91,255,.055) 1px,transparent 1px),\n    linear-gradient(90deg,rgba(246,91,255,.055) 1px,transparent 1px);\n  background-size:32px 32px;\n  mask-image:radial-gradient(120% 90% at 50% 0%,#000000 20%,transparent 78%);\n}\n.fx-pixel{\n  background-image:\n    linear-gradient(rgba(20,135,255,.05) 1px,transparent 1px),\n    linear-gradient(90deg,rgba(20,135,255,.05) 1px,transparent 1px);\n  background-size:4px 4px;\n  opacity:.5;\n}\n.fx-scan{\n  background:repeating-linear-gradient(to bottom,rgba(0,0,0,0) 0 2px,rgba(0,0,0,.35) 2px 4px);\n  opacity:.45;mix-blend-mode:multiply;\n}\n.fx-sweep{\n  background:linear-gradient(to bottom,transparent,rgba(20,135,255,.055),transparent);\n  height:220px;animation:sweep 8s linear infinite;inset:auto 0 auto 0;position:fixed;\n}\n@keyframes sweep{0%{transform:translateY(-240px)}100%{transform:translateY(100vh)}}\n.fx-bloom{\n  background:\n    radial-gradient(60% 45% at 18% -6%,rgba(20,135,255,.20),transparent 62%),\n    radial-gradient(55% 45% at 85% 4%,rgba(246,91,255,.18),transparent 65%),\n    radial-gradient(70% 50% at 50% 100%,rgba(20,135,255,.05),transparent 70%);\n}\n@media (prefers-reduced-motion:reduce){.fx-sweep{display:none}*{animation-duration:.001s!important}}\n\n.wrap{position:relative;z-index:1;max-width:var(--max);margin:0 auto;padding:0 32px}\n@media(max-width:700px){.wrap{padding:0 18px}}\n\n/* ---------- header ---------- */\nheader{position:sticky;top:0;z-index:20;backdrop-filter:blur(14px);\n  background:linear-gradient(180deg,rgba(7,5,11,.94),rgba(7,5,11,.62));\n  border-bottom:1px solid var(--line)}\n.nav{display:flex;align-items:center;gap:28px;height:68px}\n.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--txt)}\n.brand .mark{width:30px;height:30px;filter:drop-shadow(0 0 8px rgba(20,135,255,.65))}\n.brand b{font-size:18px;letter-spacing:-.02em;font-weight:700}\n.brand span{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--blue);\n  border:1px solid var(--line);padding:2px 6px;border-radius:4px;letter-spacing:.12em}\nnav.links{display:flex;gap:22px;margin-left:auto}\nnav.links a{color:var(--dim);text-decoration:none;font-size:14px;font-weight:500;position:relative;padding:4px 0}\nnav.links a:hover{color:var(--green);text-shadow:0 0 12px rgba(20,135,255,.7)}\nnav.links a::after{content:\"\";position:absolute;left:0;right:100%;bottom:0;height:1px;background:var(--green);transition:right .25s}\nnav.links a:hover::after{right:0}\n.net-pill{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:11px;\n  border:1px solid var(--line-2);border-radius:999px;padding:7px 12px;color:var(--green);\n  background:rgba(20,135,255,.05);box-shadow:0 0 18px rgba(20,135,255,.12) inset}\n.dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green);animation:pulse 1.6s infinite}\n@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.8)}}\n.menu-btn{display:none;margin-left:auto;background:none;border:1px solid var(--line);color:var(--green);\n  border-radius:6px;padding:8px 10px;font-family:'JetBrains Mono',monospace;font-size:12px}\n@media(max-width:940px){nav.links{display:none}.net-pill{display:none}.menu-btn{display:block}\n  nav.links.open{display:flex;position:absolute;top:68px;left:0;right:0;flex-direction:column;gap:0;\n    background:rgba(7,5,11,.98);border-bottom:1px solid var(--line);padding:8px 18px 16px}\n  nav.links.open a{padding:12px 0;border-bottom:1px solid rgba(246,91,255,.08)}}\n\n/* ---------- hero ---------- */\n.hero{min-height:calc(100vh - 68px);display:flex;flex-direction:column;justify-content:center;\n  padding:46px 0 34px;position:relative}\n.eyebrow{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.3em;color:var(--blue);\n  text-transform:uppercase;display:flex;align-items:center;gap:12px;margin-bottom:20px}\n.eyebrow::after{content:\"\";height:1px;flex:1;max-width:320px;background:linear-gradient(90deg,var(--blue),transparent)}\nh1{font-size:clamp(38px,6.1vw,86px);line-height:.95;letter-spacing:-.045em;font-weight:700;margin:0 0 18px;max-width:14ch}\nh1 .g{color:var(--green);text-shadow:0 0 34px rgba(20,135,255,.45)}\nh1 .b{color:var(--blue);text-shadow:0 0 34px rgba(246,91,255,.4)}\n.lede{color:var(--dim);font-size:clamp(14px,1.3vw,17px);max-width:58ch;margin:0 0 30px}\n.lede b{color:var(--txt);font-weight:500}\n\n/* search */\n.search{position:relative;max-width:860px}\n.search-inner{display:flex;align-items:center;gap:12px;border:1px solid var(--line);\n  background:rgba(11,7,17,.85);border-radius:14px;padding:6px 6px 6px 18px;\n  transition:border-color .25s,box-shadow .3s,background .25s}\n.search-inner:focus-within{border-color:var(--green);\n  box-shadow:0 0 0 1px rgba(20,135,255,.45),0 0 42px rgba(20,135,255,.30),0 0 90px rgba(20,135,255,.14);\n  background:rgba(14,9,24,.95)}\n.search svg.mg{flex:none;opacity:.75}\n.search input{flex:1;background:none;border:0;outline:none;color:var(--txt);padding:16px 0;\n  font-family:'JetBrains Mono',monospace;font-size:14px;letter-spacing:.01em;min-width:0}\n.search input::placeholder{color:#5b5270}\n.search button{flex:none;border:0;border-radius:10px;padding:14px 22px;cursor:pointer;\n  font-family:'JetBrains Mono',monospace;font-weight:700;font-size:12px;letter-spacing:.14em;\n  color:#050414;background:linear-gradient(135deg,var(--green),#7ec8ff);\n  box-shadow:0 0 26px rgba(20,135,255,.35);transition:transform .15s,box-shadow .25s}\n.search button:hover{transform:translateY(-1px);box-shadow:0 0 40px rgba(20,135,255,.6)}\n.hints{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--dim)}\n.hints span{border:1px dashed rgba(246,91,255,.25);padding:5px 9px;border-radius:6px;cursor:pointer;transition:.2s}\n.hints span:hover{color:var(--blue);border-color:var(--blue);box-shadow:0 0 18px rgba(246,91,255,.2)}\n@media(max-width:560px){.search button{padding:14px 14px}.search-inner{padding-left:14px}}\n\n/* stats bar */\n.stats{display:grid;grid-template-columns:repeat(5,1fr);margin-top:44px;\n  border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--panel);\n  box-shadow:0 0 60px rgba(0,0,0,.6),0 0 0 1px rgba(20,135,255,.05) inset}\n.stat{padding:20px 22px;border-right:1px solid var(--line);position:relative}\n.stat:last-child{border-right:0}\n.stat::before{content:\"\";position:absolute;left:0;top:0;height:2px;width:0;background:var(--green);\n  box-shadow:0 0 14px var(--green);transition:width .5s}\n.stat:hover::before{width:100%}\n.stat .k{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim)}\n.stat .v{font-size:clamp(19px,1.7vw,26px);font-weight:700;letter-spacing:-.02em;margin-top:8px;font-variant-numeric:tabular-nums}\n.stat .d{font-family:'JetBrains Mono',monospace;font-size:11px;margin-top:4px;color:var(--blue)}\n.stat .d.up{color:var(--green)}\n@media(max-width:1000px){.stats{grid-template-columns:repeat(2,1fr)}\n  .stat{border-bottom:1px solid var(--line)}.stat:nth-child(2n){border-right:0}}\n@media(max-width:420px){.stats{grid-template-columns:1fr}.stat{border-right:0}}\n\n/* ---------- sections ---------- */\nsection{padding:72px 0}\n.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}\nh2{font-size:clamp(24px,2.6vw,36px);letter-spacing:-.035em;margin:0;font-weight:700}\nh2 em{font-style:normal;color:var(--green)}\n.sec-head p{margin:6px 0 0;color:var(--dim);font-size:14px;max-width:52ch}\n.tag{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.24em;color:var(--blue);text-transform:uppercase;margin-bottom:10px;display:block}\n\n/* gas tracker */\n.gas-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:22px}\n@media(max-width:980px){.gas-grid{grid-template-columns:1fr}}\n.card{border:1px solid var(--line);border-radius:16px;background:var(--panel);padding:22px;position:relative;overflow:hidden}\n.card::after{content:\"\";position:absolute;inset:0;border-radius:16px;pointer-events:none;\n  background:radial-gradient(90% 60% at 100% 0,rgba(246,91,255,.10),transparent 60%)}\n.gas-tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n@media(max-width:560px){.gas-tiers{grid-template-columns:1fr}}\n.tier{border:1px solid rgba(246,91,255,.14);border-radius:12px;padding:16px;background:rgba(7,5,11,.6);transition:.25s}\n.tier:hover{border-color:var(--green);box-shadow:0 0 30px rgba(20,135,255,.16)}\n.tier .t{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--dim);display:flex;align-items:center;gap:7px}\n.tier .n{font-size:30px;font-weight:700;letter-spacing:-.03em;margin:10px 0 2px;font-variant-numeric:tabular-nums}\n.tier .n small{font-size:12px;font-weight:500;color:var(--dim);letter-spacing:0}\n.tier .s{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--dim)}\n.tier.mid .n{color:var(--blue)}\n.tier.fast .n{color:var(--green)}\n.spark{margin-top:20px;border-top:1px solid var(--line);padding-top:16px}\n.spark .lab{display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--dim);letter-spacing:.14em;text-transform:uppercase;margin-bottom:10px}\n.util-row{display:flex;align-items:center;gap:14px;margin-top:16px}\n.bar{flex:1;height:8px;border-radius:99px;background:rgba(246,91,255,.12);overflow:hidden}\n.bar i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--green));\n  box-shadow:0 0 18px rgba(20,135,255,.6);transition:width .8s cubic-bezier(.2,.8,.2,1)}\n.mono{font-family:'JetBrains Mono',monospace}\n.kv{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid rgba(246,91,255,.1);font-size:13px}\n.kv:last-child{border-bottom:0}\n.kv span:first-child{color:var(--dim)}\n.kv span:last-child{font-family:'JetBrains Mono',monospace;color:var(--txt)}\n\n/* tables */\n.tables{display:grid;grid-template-columns:1fr 1fr;gap:22px}\n@media(max-width:1060px){.tables{grid-template-columns:1fr}}\n.panel{border:1px solid var(--line);border-radius:16px;background:var(--panel);overflow:hidden}\n.panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px;\n  padding:16px 20px;border-bottom:1px solid var(--line);background:rgba(20,135,255,.03)}\n.panel-head h3{margin:0;font-size:15px;letter-spacing:-.01em;display:flex;align-items:center;gap:9px}\n.panel-head .mono{font-size:10px;color:var(--dim);letter-spacing:.16em;text-transform:uppercase}\n.rows{max-height:none}\n.row{display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid rgba(246,91,255,.08);\n  transition:background .2s;animation:fadeIn .5s ease both}\n.row:last-child{border-bottom:0}\n.row:hover{background:rgba(20,135,255,.045)}\n@keyframes fadeIn{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}\n.ico{width:38px;height:38px;flex:none;border-radius:10px;display:grid;place-items:center;\n  border:1px solid rgba(20,135,255,.22);background:rgba(20,135,255,.06);\n  font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--green)}\n.ico.tx{border-color:rgba(246,91,255,.25);background:rgba(246,91,255,.07);color:var(--blue)}\n.row .main{flex:1;min-width:0}\n.row .main a{color:var(--green);text-decoration:none;font-family:'JetBrains Mono',monospace;font-size:13px}\n.row .main a:hover{text-shadow:0 0 14px rgba(20,135,255,.7)}\n.row .main a.b{color:var(--blue)}\n.row .main a.b:hover{text-shadow:0 0 14px rgba(246,91,255,.7)}\n.row .sub{font-size:11.5px;color:var(--dim);font-family:'JetBrains Mono',monospace;margin-top:3px;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.row .mid{flex:1.15;min-width:0;font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--dim)}\n.row .mid b{color:var(--txt);font-weight:400}\n.amt{flex:none;text-align:right;font-family:'JetBrains Mono',monospace;font-size:12px;\n  border:1px solid rgba(246,91,255,.16);padding:5px 9px;border-radius:7px;color:var(--txt);background:rgba(7,5,11,.6)}\n@media(max-width:620px){.row .mid{display:none}}\n.panel-foot{padding:13px 20px;text-align:center;border-top:1px solid var(--line)}\n.panel-foot a{color:var(--blue);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.18em;text-decoration:none;text-transform:uppercase}\n.panel-foot a:hover{color:var(--green)}\n\n/* validators strip */\n.strip{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}\n@media(max-width:900px){.strip{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:480px){.strip{grid-template-columns:1fr}}\n.strip .card{padding:20px}\n.strip h4{margin:14px 0 6px;font-size:15px}\n.strip p{margin:0;color:var(--dim);font-size:13px}\n.glyph{width:34px;height:34px;filter:drop-shadow(0 0 10px rgba(246,91,255,.5))}\n\n/* footer */\nfooter{border-top:1px solid var(--line);padding:40px 0 60px;position:relative;z-index:1}\n.f-grid{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap}\n.f-col h5{margin:0 0 12px;font-size:11px;font-family:'JetBrains Mono',monospace;letter-spacing:.2em;\n  text-transform:uppercase;color:var(--blue)}\n.f-col a{display:block;color:var(--dim);text-decoration:none;font-size:13px;padding:4px 0}\n.f-col a:hover{color:var(--green)}\n.f-bottom{margin-top:34px;padding-top:18px;border-top:1px solid rgba(246,91,255,.1);\n  display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;\n  font-family:'JetBrains Mono',monospace;font-size:11px;color:#594f6b}\n::selection{background:rgba(20,135,255,.3);color:#ffffff}\n</style>\n</head>\n<body>\n<!--tr-cover-->\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700;800;900&family=Inter:wght@400;500;700&display=swap\" rel=\"stylesheet\">\n<style>\n.trc{--a:#7c6bff;position:relative;z-index:1000;height:100vh;min-height:620px;overflow:hidden;background:#000;color:#fff;font-family:Inter,system-ui,sans-serif;isolation:isolate}\n.trc-s{position:absolute;inset:-4%;background-size:cover;background-position:center;opacity:0;transition:opacity 1.4s ease;animation:trcKen 18s ease-in-out infinite alternate}\n.trc-s.on{opacity:1}\n@keyframes trcKen{from{transform:scale(1) translate3d(0,0,0)}to{transform:scale(1.09) translate3d(-1.5%,-1%,0)}}\n.trc::before{content:\"\";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 22%,rgba(0,0,0,0) 48%,rgba(0,0,0,.82) 100%)}\n.trc-nav{position:absolute;z-index:3;top:18px;left:24px;right:24px;display:flex;align-items:center;gap:26px;padding:10px 12px 10px 16px;border-radius:14px;background:rgba(10,10,12,.42);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.12)}\n.trc-logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:15px;letter-spacing:-.01em;white-space:nowrap}\n.trc-logo i{width:26px;height:26px;border-radius:7px;background:var(--a);box-shadow:0 0 22px var(--a);display:grid;place-items:center;font-style:normal;color:#000;font-size:13px;font-weight:900}\n.trc-links{display:flex;gap:22px;flex:1}\n.trc-links a{color:rgba(255,255,255,.78);text-decoration:none;font-size:13.5px;font-weight:500}\n.trc-links a:hover{color:#fff}\n.trc-btn{height:38px;padding:0 16px;border-radius:10px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.06);color:#fff;font:600 13px Inter,sans-serif;cursor:pointer;white-space:nowrap}\n.trc-btn.pri{background:var(--a);border-color:var(--a);color:#000;box-shadow:0 8px 28px -8px var(--a)}\n.trc-copy{position:absolute;z-index:3;left:48px;right:48px;bottom:56px;max-width:880px}\n.trc-chip{display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.18);font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}\n.trc-chip b{width:7px;height:7px;border-radius:50%;background:var(--a);box-shadow:0 0 10px var(--a)}\n.trc h1{font-family:\"Space Grotesk\",Inter,sans-serif;font-weight:900;font-size:clamp(44px,9vw,150px);line-height:.9;white-space:nowrap;letter-spacing:-.02em;margin:18px 0 14px;text-shadow:0 8px 40px rgba(0,0,0,.45)}\n.trc h1 em{font-style:normal;color:var(--a)}\n.trc p{font-size:clamp(16px,1.6vw,20px);line-height:1.45;color:rgba(255,255,255,.86);max-width:560px;margin:0 0 24px}\n.trc-ctas{display:flex;gap:10px;flex-wrap:wrap}\n.trc-ctas .trc-btn{height:48px;padding:0 22px;font-size:14.5px;border-radius:12px}\n.trc-dots{position:absolute;z-index:3;right:48px;bottom:64px;display:flex;align-items:center;gap:8px;font:600 12px Inter,sans-serif;color:rgba(255,255,255,.75)}\n.trc-dots i{width:22px;height:3px;border-radius:3px;background:rgba(255,255,255,.3);transition:.4s}\n.trc-dots i.on{width:44px;background:var(--a)}\n.trc-dots span{margin-left:8px;letter-spacing:.08em}\n@media(max-width:760px){.trc-links{display:none}.trc-nav{left:12px;right:12px;gap:10px;justify-content:space-between}.trc-nav .trc-btn:not(.pri){display:none}.trc-copy{left:20px;right:20px;bottom:40px}.trc-dots{display:none}}\n</style>\n<section class=\"trc\" data-trc=\"explorer\">\n  <div class=\"trc-s on\" style=\"background-image:url(/img/cover/tldraw-make-real.jpg)\"></div><div class=\"trc-s\" style=\"background-image:url(/img/cover/open-generative-ai.jpg)\"></div>\n  <nav class=\"trc-nav\"><div class=\"trc-logo\"><i>R</i>RoboScan</div><div class=\"trc-links\"><a href=\"#\">Blocks</a><a href=\"#\">Txns</a><a href=\"#\">Tokens</a><a href=\"#\">Charts</a></div><button class=\"trc-btn\">Sign in</button><button class=\"trc-btn pri\">Search the chain</button></nav>\n  <div class=\"trc-copy\"><span class=\"trc-chip\"><b></b>Chain explorer · Robinhood Chain</span><h1><em>RoboScan</em></h1><p>X-ray vision for Robinhood Chain. Every block, every wallet, in real time.</p>\n    <div class=\"trc-ctas\"><button class=\"trc-btn pri\">Search the chain</button><button class=\"trc-btn\">Learn more</button></div></div>\n  <div class=\"trc-dots\"><i class=on></i><i></i><span>01 / 02</span></div>\n</section>\n<script>(function(){var r=document.querySelector('[data-trc]'),s=r.querySelectorAll('.trc-s'),d=r.querySelectorAll('.trc-dots i'),n=r.querySelector('.trc-dots span'),k=0;\nfunction go(i){k=i%s.length;s.forEach(function(e,j){e.classList.toggle('on',j===k)});d.forEach(function(e,j){e.classList.toggle('on',j===k)});if(n)n.textContent='0'+(k+1)+' / 0'+s.length}\nvar h=/#s(\\d)/.exec(location.hash);if(h)go(+h[1]-1);else if(s.length>1)setInterval(function(){go(k+1)},5200);}());</script>\n<!--/tr-cover-->\n\n\n\n<div class=\"fx fx-bloom\"></div>\n<div class=\"fx fx-grid\"></div>\n<div class=\"fx fx-pixel\"></div>\n<div class=\"fx fx-scan\"></div>\n<div class=\"fx-sweep\"></div>\n\n<header>\n  <div class=\"wrap nav\">\n    <a class=\"brand\" href=\"#\">\n      <svg class=\"mark\" viewBox=\"0 0 32 32\" fill=\"none\" aria-hidden=\"true\">\n        <path d=\"M16 1.5 29 8.7v14.6L16 30.5 3 23.3V8.7L16 1.5Z\" stroke=\"#1487ff\" stroke-width=\"1.6\"/>\n        <path d=\"M11 22V10h6.2c2.4 0 3.8 1.3 3.8 3.4 0 1.7-.9 2.8-2.5 3.2L21.6 22h-3.3l-2.7-4.9H13.8V22H11Zm2.8-7.1h2.9c1 0 1.6-.5 1.6-1.4s-.6-1.4-1.6-1.4h-2.9v2.8Z\" fill=\"#1487ff\"/>\n      </svg>\n      <b>RoboScan</b><span>MAINNET</span>\n    </a>\n    <button class=\"menu-btn\" id=\"menuBtn\" aria-label=\"Menu\">MENU</button>\n    <nav class=\"links\" id=\"links\">\n      <a href=\"#blocks\">Blocks</a>\n      <a href=\"#txs\">Transactions</a>\n      <a href=\"#gas\">Gas Tracker</a>\n      <a href=\"#validators\">Validators</a>\n      <a href=\"#\">Tokens</a>\n      <a href=\"#\">API</a>\n    </nav>\n    <div class=\"net-pill\"><i class=\"dot\"></i> RBH $2.418 <span style=\"color:var(--dim)\">·</span> 0.7s blocks</div>\n  </div>\n</header>\n\n<main>\n<div class=\"wrap\">\n  <section class=\"hero\">\n    <span class=\"eyebrow\">Robinhood Chain · Layer 2 · Chain ID 48211</span>\n    <h1>Read the <span class=\"g\">chain</span><br>at <span class=\"b\">line speed</span>.</h1>\n    <p class=\"lede\">RoboScan indexes every block, transaction, log and contract on Robinhood Chain — <b>sub-second finality</b>, tokenized equities settlement, and a public firehose you can query for free.</p>\n\n    <form class=\"search\" id=\"searchForm\" role=\"search\">\n      <div class=\"search-inner\">\n        <svg class=\"mg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1487ff\" stroke-width=\"2\" aria-hidden=\"true\">\n          <circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/>\n        </svg>\n        <input id=\"q\" type=\"text\" aria-label=\"Search the chain\" placeholder=\"Search by address / txn hash / block / token / ENS…\" autocomplete=\"off\">\n        <button type=\"submit\">SEARCH</button>\n      </div>\n      <div class=\"hints\" id=\"hints\">\n        <span data-q=\"0x7f3ac1e94d2b8e6a0c5d19f8b7e34a2c96d0518f\">0x7f3a…518f</span>\n        <span data-q=\"19482057\">Block 19,482,057</span>\n        <span data-q=\"hood.rbh\">hood.rbh</span>\n        <span data-q=\"RBH-USDC pool\">RBH-USDC pool</span>\n        <span data-q=\"Tokenized AAPL\">Tokenized AAPL</span>\n      </div>\n    </form>\n\n    <div class=\"stats\" aria-label=\"Network statistics\">\n      <div class=\"stat\">\n        <div class=\"k\">Latest Block</div>\n        <div class=\"v mono\" id=\"s-block\">19,482,057</div>\n        <div class=\"d up\">▲ 0.7s avg time</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"k\">Transactions / sec</div>\n        <div class=\"v mono\" id=\"s-tps\">3,914</div>\n        <div class=\"d\">peak 11,206 tps</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"k\">Total Txns</div>\n        <div class=\"v mono\" id=\"s-total\">8,412,776,301</div>\n        <div class=\"d up\">+ 41.2M / 24h</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"k\">Median Gas</div>\n        <div class=\"v mono\" id=\"s-gas\">0.031 <small style=\"font-size:12px;color:var(--dim)\">gwei</small></div>\n        <div class=\"d\">$0.0004 per swap</div>\n      </div>\n      <div class=\"stat\">\n        <div class=\"k\">Active Validators</div>\n        <div class=\"v mono\">1,284</div>\n        <div class=\"d up\">99.997% uptime</div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<!-- GAS TRACKER -->\n<div class=\"wrap\">\n  <section id=\"gas\">\n    <div class=\"sec-head\">\n      <div>\n        <span class=\"tag\">Live fee market</span>\n        <h2>Gas <em>Tracker</em></h2>\n        <p>Priority fees recalculated every block from the last 32 blocks of base-fee data.</p>\n      </div>\n      <div class=\"mono\" style=\"font-size:11px;color:var(--dim)\">UPDATED <span id=\"gasAgo\" style=\"color:var(--green)\">2s</span> AGO</div>\n    </div>\n\n    <div class=\"gas-grid\">\n      <div class=\"card\">\n        <div class=\"gas-tiers\">\n          <div class=\"tier slow\">\n            <div class=\"t\"><i class=\"dot\" style=\"background:#877e9a;box-shadow:none\"></i>Safe</div>\n            <div class=\"n mono\" id=\"g-slow\">0.024 <small>gwei</small></div>\n            <div class=\"s\">~6s · $0.0003</div>\n          </div>\n          <div class=\"tier mid\">\n            <div class=\"t\"><i class=\"dot\" style=\"background:var(--blue);box-shadow:0 0 10px var(--blue)\"></i>Standard</div>\n            <div class=\"n mono\" id=\"g-mid\">0.031 <small>gwei</small></div>\n            <div class=\"s\">~1.4s · $0.0004</div>\n          </div>\n          <div class=\"tier fast\">\n            <div class=\"t\"><i class=\"dot\"></i>Rapid</div>\n            <div class=\"n mono\" id=\"g-fast\">0.048 <small>gwei</small></div>\n            <div class=\"s\">&lt;0.7s · $0.0006</div>\n          </div>\n        </div>\n\n        <div class=\"spark\">\n          <div class=\"lab\"><span>Base fee · last 32 blocks</span><span id=\"sparkRange\">0.019 – 0.052 gwei</span></div>\n          <svg id=\"spark\" viewBox=\"0 0 640 120\" preserveAspectRatio=\"none\" style=\"width:100%;height:120px;display:block\" aria-hidden=\"true\">\n            <defs>\n              <linearGradient id=\"fill\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                <stop offset=\"0\" stop-color=\"#1487ff\" stop-opacity=\".38\"/>\n                <stop offset=\"1\" stop-color=\"#1487ff\" stop-opacity=\"0\"/>\n              </linearGradient>\n              <filter id=\"glow\"><feGaussianBlur stdDeviation=\"3.2\" result=\"b\"/><feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>\n            </defs>\n            <g stroke=\"rgba(246,91,255,.12)\">\n              <line x1=\"0\" y1=\"30\" x2=\"640\" y2=\"30\"/><line x1=\"0\" y1=\"60\" x2=\"640\" y2=\"60\"/><line x1=\"0\" y1=\"90\" x2=\"640\" y2=\"90\"/>\n            </g>\n            <path id=\"sparkFill\" fill=\"url(#fill)\" d=\"\"></path>\n            <path id=\"sparkLine\" fill=\"none\" stroke=\"#1487ff\" stroke-width=\"2\" filter=\"url(#glow)\" d=\"\"></path>\n          </svg>\n        </div>\n\n        <div class=\"util-row\">\n          <span class=\"mono\" style=\"font-size:10px;letter-spacing:.14em;color:var(--dim)\">BLOCK FILL</span>\n          <div class=\"bar\"><i id=\"fillBar\" style=\"width:46%\"></i></div>\n          <span class=\"mono\" id=\"fillPct\" style=\"font-size:12px;color:var(--green)\">46%</span>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"mono\" style=\"font-size:10px;letter-spacing:.2em;color:var(--blue);text-transform:uppercase\">Cost to execute</div>\n        <div style=\"margin-top:14px\">\n          <div class=\"kv\"><span>RBH transfer</span><span>$0.00021</span></div>\n          <div class=\"kv\"><span>ERC-20 transfer</span><span>$0.00046</span></div>\n          <div class=\"kv\"><span>DEX swap</span><span>$0.00093</span></div>\n          <div class=\"kv\"><span>Equity settlement</span><span>$0.00118</span></div>\n          <div class=\"kv\"><span>NFT mint</span><span>$0.00074</span></div>\n          <div class=\"kv\"><span>Contract deploy</span><span>$0.01402</span></div>\n        </div>\n        <div style=\"margin-top:18px;border-top:1px solid var(--line);padding-top:14px\" class=\"mono\">\n          <div style=\"font-size:10px;letter-spacing:.18em;color:var(--dim);text-transform:uppercase\">Burnt last 24h</div>\n          <div style=\"font-size:26px;font-weight:700;color:var(--green);margin-top:6px;font-family:'Space Grotesk'\">12,904.77 <span style=\"font-size:13px;color:var(--dim);font-family:'JetBrains Mono'\">RBH</span></div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<!-- TABLES -->\n<div class=\"wrap\">\n  <section id=\"blocks\" style=\"padding-top:12px\">\n    <div class=\"sec-head\">\n      <div>\n        <span class=\"tag\">Firehose</span>\n        <h2>Latest <em>blocks</em> &amp; transactions</h2>\n        <p>Streaming live from the RoboScan indexer. New entries appear at the top as validators seal them.</p>\n      </div>\n      <div class=\"net-pill\" style=\"display:flex\"><i class=\"dot\"></i> STREAMING</div>\n    </div>\n\n    <div class=\"tables\">\n      <div class=\"panel\" id=\"txs\">\n        <div class=\"panel-head\">\n          <h3><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1487ff\" stroke-width=\"2\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"3\"/><path d=\"M3 9h18M8 4v16\"/></svg> Latest Blocks</h3>\n          <span class=\"mono\">last 8</span>\n        </div>\n        <div class=\"rows\" id=\"blockRows\"></div>\n        <div class=\"panel-foot\"><a href=\"#\">View all blocks →</a></div>\n      </div>\n\n      <div class=\"panel\">\n        <div class=\"panel-head\">\n          <h3><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f65bff\" stroke-width=\"2\"><path d=\"M4 8h12l-3-3M20 16H8l3 3\"/></svg> Latest Transactions</h3>\n          <span class=\"mono\">last 8</span>\n        </div>\n        <div class=\"rows\" id=\"txRows\"></div>\n        <div class=\"panel-foot\"><a href=\"#\">View all transactions →</a></div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<!-- VALIDATORS / FEATURES -->\n<div class=\"wrap\">\n  <section id=\"validators\" style=\"padding-top:12px\">\n    <div class=\"sec-head\">\n      <div><span class=\"tag\">Infrastructure</span><h2>Built on <em>verifiable</em> rails</h2></div>\n    </div>\n    <div class=\"strip\">\n      <div class=\"card\">\n        <svg class=\"glyph\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f65bff\" stroke-width=\"1.7\"><path d=\"M12 2 3 6v6c0 5 3.8 8.6 9 10 5.2-1.4 9-5 9-10V6l-9-4Z\"/><path d=\"m8.5 12 2.5 2.5 4.5-5\" stroke=\"#1487ff\"/></svg>\n        <h4>Proof-published state</h4>\n        <p>Every 128 blocks a validity proof is posted to L1 and verified here in under 400ms.</p>\n      </div>\n      <div class=\"card\">\n        <svg class=\"glyph\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1487ff\" stroke-width=\"1.7\"><path d=\"M4 19V5m16 14V5M4 12h16\"/><circle cx=\"8\" cy=\"8\" r=\"2\"/><circle cx=\"16\" cy=\"16\" r=\"2\" stroke=\"#f65bff\"/></svg>\n        <h4>1,284 validators</h4>\n        <p>Stake-weighted set rotating each epoch. Slashing history is fully public and searchable.</p>\n      </div>\n      <div class=\"card\">\n        <svg class=\"glyph\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#f65bff\" stroke-width=\"1.7\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M7 9h6M7 13h10M7 17h4\" stroke=\"#1487ff\"/></svg>\n        <h4>Verified contracts</h4>\n        <p>413,902 sources matched byte-for-byte, with decoded logs and a built-in read/write console.</p>\n      </div>\n      <div class=\"card\">\n        <svg class=\"glyph\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#1487ff\" stroke-width=\"1.7\"><path d=\"M12 3v18M3 12h18\" stroke=\"#f65bff\"/><circle cx=\"12\" cy=\"12\" r=\"8.5\"/></svg>\n        <h4>Free public API</h4>\n        <p>REST, GraphQL and websocket endpoints. 100k requests a day, no key required.</p>\n      </div>\n    </div>\n  </section>\n</div>\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"f-grid\">\n      <div style=\"max-width:300px\">\n        <a class=\"brand\" href=\"#\" style=\"margin-bottom:12px\">\n          <svg class=\"mark\" viewBox=\"0 0 32 32\" fill=\"none\"><path d=\"M16 1.5 29 8.7v14.6L16 30.5 3 23.3V8.7L16 1.5Z\" stroke=\"#1487ff\" stroke-width=\"1.6\"/><path d=\"M11 22V10h6.2c2.4 0 3.8 1.3 3.8 3.4 0 1.7-.9 2.8-2.5 3.2L21.6 22h-3.3l-2.7-4.9H13.8V22H11Z\" fill=\"#1487ff\"/></svg>\n          <b>RoboScan</b>\n        </a>\n        <p style=\"color:var(--dim);font-size:13px;margin:0\">The open block explorer for Robinhood Chain. Independent, ad-free, community indexed.</p>\n      </div>\n      <div class=\"f-col\"><h5>Explore</h5><a href=\"#\">Blocks</a><a href=\"#\">Transactions</a><a href=\"#\">Accounts</a><a href=\"#\">Verified contracts</a></div>\n      <div class=\"f-col\"><h5>Tokens</h5><a href=\"#\">ERC-20</a><a href=\"#\">Tokenized equities</a><a href=\"#\">NFT collections</a><a href=\"#\">Top holders</a></div>\n      <div class=\"f-col\"><h5>Developers</h5><a href=\"#\">API docs</a><a href=\"#\">Websocket feed</a><a href=\"#\">Contract verifier</a><a href=\"#\">Status</a></div>\n      <div class=\"f-col\"><h5>Network</h5><a href=\"#\">Validators</a><a href=\"#\">Epoch schedule</a><a href=\"#\">Bridge activity</a><a href=\"#\">Governance</a></div>\n    </div>\n    <div class=\"f-bottom\">\n      <span>© 2025 ROBOSCAN LABS · CHAIN ID 48211</span>\n      <span>SYNCED BLOCK <span id=\"footBlock\" style=\"color:var(--green)\">19,482,057</span> · LATENCY 38ms</span>\n    </div>\n  </div>\n</footer>\n\n<script>\n(function(){\n  const $ = s => document.querySelector(s);\n  const hex = n => { let s='0x'; const c='0123456789abcdef'; for(let i=0;i<n;i++) s+=c[Math.random()*16|0]; return s; };\n  const short = (h,a=6,b=4) => h.slice(0,a+2)+'…'+h.slice(-b);\n  const num = n => n.toLocaleString('en-US');\n  const rnd = (a,b) => a + Math.random()*(b-a);\n\n  /* menu */\n  $('#menuBtn').addEventListener('click',()=>$('#links').classList.toggle('open'));\n\n  /* search */\n  $('#searchForm').addEventListener('submit',e=>{\n    e.preventDefault();\n    const btn = e.target.querySelector('button');\n    const old = btn.textContent;\n    btn.textContent = 'SCANNING…';\n    setTimeout(()=>{btn.textContent=old;},900);\n  });\n  document.querySelectorAll('#hints span').forEach(s=>{\n    s.addEventListener('click',()=>{ const i=$('#q'); i.value=s.dataset.q; i.focus(); });\n  });\n\n  /* state */\n  let block = 19482057, total = 8412776301;\n  const validators = ['Hoodnode-07','Rook Capital','stake.rbh','Aurora Relay','Cygnus-12','Meridian','Fennec Labs','Helix-03','Orbital','Quantum Keep'];\n  const actions = ['Transfer','Swap','Settle · AAPL','Mint','Bridge in','Stake','Approve','Swap · RBH/USDC','Settle · TSLA','Claim'];\n\n  /* blocks */\n  const blockRows = $('#blockRows'), txRows = $('#txRows');\n  function blockRow(n){\n    const txs = Math.round(rnd(420,3200));\n    const v = validators[Math.random()*validators.length|0];\n    const reward = rnd(0.008,0.092).toFixed(5);\n    const el = document.createElement('div');\n    el.className='row';\n    el.innerHTML = `<div class=\"ico\">BK</div>\n      <div class=\"main\"><a href=\"#\">${num(n)}</a><div class=\"sub\">${(Math.random()*8+1|0)}s ago</div></div>\n      <div class=\"mid\">Sealed by <b>${v}</b><br>${num(txs)} txns</div>\n      <div class=\"amt\">${reward} RBH</div>`;\n    return el;\n  }\n  function txRow(){\n    const h = hex(64), from = hex(40), to = hex(40);\n    const val = (Math.random()<.25 ? rnd(100,9800) : rnd(0.01,42)).toFixed(3);\n    const el = document.createElement('div');\n    el.className='row';\n    el.innerHTML = `<div class=\"ico tx\">TX</div>\n      <div class=\"main\"><a class=\"b\" href=\"#\">${short(h)}</a><div class=\"sub\">${actions[Math.random()*actions.length|0]} · ${(Math.random()*20+1|0)}s ago</div></div>\n      <div class=\"mid\">From <b>${short(from,4,4)}</b><br>To&nbsp;&nbsp;&nbsp;<b>${short(to,4,4)}</b></div>\n      <div class=\"amt\">${val} RBH</div>`;\n    return el;\n  }\n  function seed(){\n    for(let i=0;i<8;i++) blockRows.appendChild(blockRow(block-i));\n    for(let i=0;i<8;i++) txRows.appendChild(txRow());\n  }\n  seed();\n\n  function pushBlock(){\n    block++; total += Math.round(rnd(900,3400));\n    blockRows.insertBefore(blockRow(block), blockRows.firstChild);\n    while(blockRows.children.length>8) blockRows.lastChild.remove();\n    $('#s-block').textContent = num(block);\n    $('#footBlock').textContent = num(block);\n    $('#s-total').textContent = num(total);\n    $('#s-tps').textContent = num(Math.round(rnd(2800,5200)));\n    const fill = Math.round(rnd(28,86));\n    $('#fillBar').style.width = fill+'%';\n    $('#fillPct').textContent = fill+'%';\n  }\n  function pushTx(){\n    txRows.insertBefore(txRow(), txRows.firstChild);\n    while(txRows.children.length>8) txRows.lastChild.remove();\n  }\n\n  /* gas */\n  let gasData = Array.from({length:32},()=>rnd(0.019,0.052));\n  function drawSpark(){\n    const w=640,h=120,pad=8;\n    const min=Math.min(...gasData), max=Math.max(...gasData);\n    const pts = gasData.map((v,i)=>{\n      const x = i/(gasData.length-1)*w;\n      const y = pad + (1-(v-min)/((max-min)||1))*(h-pad*2);\n      return [x,y];\n    });\n    let d = 'M'+pts[0][0]+' '+pts[0][1];\n    for(let i=1;i<pts.length;i++){\n      const [x0,y0]=pts[i-1], [x1,y1]=pts[i], cx=(x0+x1)/2;\n      d += ` C${cx} ${y0}, ${cx} ${y1}, ${x1} ${y1}`;\n    }\n    $('#sparkLine').setAttribute('d',d);\n    $('#sparkFill').setAttribute('d', d+` L${w} ${h} L0 ${h} Z`);\n    $('#sparkRange').textContent = min.toFixed(3)+' – '+max.toFixed(3)+' gwei';\n    const mid = gasData[gasData.length-1];\n    $('#g-slow').innerHTML = (mid*0.78).toFixed(3)+' <small>gwei</small>';\n    $('#g-mid').innerHTML  = mid.toFixed(3)+' <small>gwei</small>';\n    $('#g-fast').innerHTML = (mid*1.55).toFixed(3)+' <small>gwei</small>';\n    $('#s-gas').innerHTML  = mid.toFixed(3)+' <small style=\"font-size:12px;color:var(--dim)\">gwei</small>';\n  }\n  drawSpark();\n\n  let ago = 0;\n  setInterval(()=>{ ago++; $('#gasAgo').textContent = ago+'s'; },1000);\n\n  setInterval(pushBlock, 2600);\n  setInterval(pushTx, 1500);\n  setInterval(()=>{\n    gasData.push(Math.max(0.014, Math.min(0.072, gasData[gasData.length-1] + rnd(-0.008,0.008))));\n    gasData.shift(); drawSpark(); ago = 0;\n  }, 5200);\n})();\n</script>\n</body>\n</html>", "at": 1790349560031}]}