{
  "name": "triump-ai",
  "version": "2.0.0",
  "private": true,
  "description": "TRIUMP AI \u2014 curated open-source, self-hostable AI design tools \u00b7 $TRIUMP on Robinhood Chain",
  "type": "module",
  "engines": {
    "node": ">=22.9"
